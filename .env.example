# Read-only MongoDB connection string used by the site (user bisaat_ro).
MONGODB_URI_READ=
# Read-write MongoDB connection string, used only by the seed script (user bisaat_rw).
MONGODB_URI_WRITE=
# MongoDB database name.
MONGODB_DB=
# Maximum API requests per minute per IP before a 429 is returned.
RATE_LIMIT_PER_MINUTE=
# Public base URL of the site (used for metadata and canonical links).
SITE_URL=
# Docker compose: MongoDB root username.
MONGO_ROOT_USERNAME=
# Docker compose: MongoDB root password.
MONGO_ROOT_PASSWORD=
# Docker compose: password for the read-only app user bisaat_ro.
MONGO_APP_RO_PASSWORD=
# Docker compose: password for the read-write app user bisaat_rw.
MONGO_APP_RW_PASSWORD=
# MongoDB root URI used only by the seed integration test (throwaway databases).
MONGODB_URI_TEST=
